% Entrada de controle do abntex2cite para adequação à NBR 10520:2023:
% autor em caixa normal nas citações parentéticas (Autor, ano) em vez de (AUTOR, ano),
% e "et al." em itálico. Deve ser ativada com \citeoption{abnt-opcoes-nbr2023}
% como a primeira citação do documento (logo após \begin{document}).
@ABNT-options{abnt-opcoes-nbr2023,
  key             = {x},
  abnt-cite-style = {(Author, YEAR)},
  abnt-etal-text  = {\textit{et al.}}
}
